# ============================================================
# GUNI Bus Driver App – Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# Expo reads variables prefixed with EXPO_PUBLIC_ into the app bundle.

# Backend API base URL
# - Android Emulator: http://10.0.2.2:5001/api
# - iOS Simulator:    http://localhost:5001/api
# - Physical Device:  http://<your-machine-local-ip>:5001/api
# - Production:       https://your-deployed-api.com/api
EXPO_PUBLIC_API_URL=http://10.0.2.2:5001/api

# Toggle for web-style login screen (set to true to test web UI)
# EXPO_PUBLIC_USE_WEB_LOGIN=true
